# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
# Option 1: Use DATABASE_URL for hosted databases (Supabase, Railway, Neon)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Option 2: Use individual params for local development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_NAME=nebbler_dev
DB_SSL=false

# Logging
LOG_LEVEL=debug
